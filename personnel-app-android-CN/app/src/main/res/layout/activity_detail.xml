<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/header_background"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 返回按钮 -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:padding="8dp"
            android:contentDescription="返回"
            app:tint="@color/text_white" />

        <!-- 标题 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="人员详情"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:gravity="center"
            android:layout_marginEnd="40dp" />

    </LinearLayout>

    <!-- 滚动内容 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 头像（圆形白色背景） -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_avatar_circle_white">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar_placeholder"
                    android:contentDescription="头像" />

            </FrameLayout>

            <!-- 基本信息（两列布局 - 使用 Guideline 对齐） -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <!-- 垂直分割线：50% 位置 -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineMiddle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <!-- 第一行：姓名和性别 -->
                <TextView
                    android:id="@+id/labelName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="姓  名："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelName"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="@id/labelName"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/labelGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="性别："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="@id/labelName"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tvGender"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelGender"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/labelGender" />

                <!-- 第二行：出生年月和学历 -->
                <TextView
                    android:id="@+id/labelBirthDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="出生年月："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toBottomOf="@id/labelName"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvBirthDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelBirthDate"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="@id/labelBirthDate"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/labelEducation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="学历："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="@id/labelBirthDate"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tvEducation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelEducation"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/labelEducation" />

                <!-- 第三行：工作时间和身份 -->
                <TextView
                    android:id="@+id/labelWorkStartDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="工作时间："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toBottomOf="@id/labelBirthDate"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvWorkStartDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelWorkStartDate"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="@id/labelWorkStartDate"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/labelIdentity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="身份："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="@id/labelWorkStartDate"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tvIdentity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelIdentity"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/labelIdentity" />

                <!-- 第四行：政治面貌和籍贯 -->
                <TextView
                    android:id="@+id/labelPoliticalStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="政治面貌："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toBottomOf="@id/labelWorkStartDate"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvPoliticalStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelPoliticalStatus"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="@id/labelPoliticalStatus"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/labelNativePlace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="籍贯："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="@id/labelPoliticalStatus"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tvNativePlace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelNativePlace"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/labelNativePlace" />

                <!-- 第五行：入党时间和现住址 -->
                <TextView
                    android:id="@+id/labelPartyJoinDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="入党时间："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toBottomOf="@id/labelPoliticalStatus"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvPartyJoinDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelPartyJoinDate"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="@id/labelPartyJoinDate"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/labelAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="现住址："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="@id/guidelineMiddle"
                    app:layout_constraintTop_toTopOf="@id/labelPartyJoinDate"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelAddress"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/labelAddress" />

                <!-- 第六行：现任职务（跨整行） -->
                <TextView
                    android:id="@+id/labelPosition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="现任职务："
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/labelPartyJoinDate"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvPosition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    app:layout_constraintStart_toEndOf="@id/labelPosition"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/labelPosition"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 个人简历 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="个人简历："
                android:textSize="14sp"
                android:textColor="@color/text_white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvWorkExperiences"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_box"
                android:padding="12dp"
                android:textSize="13sp"
                android:textColor="@color/text_white"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <!-- 家庭成员及重要社会关系 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="家庭成员及重要社会关系："
                android:textSize="14sp"
                android:textColor="@color/text_white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvFamilyMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_box"
                android:padding="12dp"
                android:textSize="13sp"
                android:textColor="@color/text_white"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <!-- 个人奖惩 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="个人奖惩："
                android:textSize="14sp"
                android:textColor="@color/text_white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvAwards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_box"
                android:padding="12dp"
                android:textSize="13sp"
                android:textColor="@color/text_white"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <!-- 简要评价 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="简要评价："
                android:textSize="14sp"
                android:textColor="@color/text_white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_box"
                android:padding="12dp"
                android:textSize="13sp"
                android:textColor="@color/text_white"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
